{
  "version": 2,
  "outputDirectory": "public",
  "functions": {
    "api/**/*.ts": {
      "runtime": "@vercel/node@5.0.0"
    }
  },
  "rewrites": [
    {
      "source": "/api/boards",
      "destination": "/api/boards"
    },
    {
      "source": "/api/state",
      "destination": "/api/state"
    },
    {
      "source": "/api/leaderboard",
      "destination": "/api/leaderboard"
    },
    {
      "source": "/api/balance",
      "destination": "/api/balance"
    },
    {
      "source": "/api/initiate-payment",
      "destination": "/api/initiate-payment"
    },
    {
      "source": "/api/withdraw",
      "destination": "/api/withdraw"
    },
    {
      "source": "/api/setup-webhook",
      "destination": "/api/setup-webhook"
    },
    {
      "source": "/api/webhook/crypto-pay",
      "destination": "/api/webhook/crypto-pay"
    },
    {
      "source": "/api/webhook/telegram",
      "destination": "/api/webhook/telegram"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization, X-Telegram-Init-Data"
        }
      ]
    },
    {
      "source": "/((?!api/).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
