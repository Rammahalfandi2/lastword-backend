{
  // Cloudflare Worker for The Last Word (API + Mini App). Supabase stays the database.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lastword",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Mini App static files. The Worker also embeds them (src/static.ts) as a fallback.
  "assets": { "directory": "public", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "vars": { "BASE_URL": "https://lastword.khazna.workers.dev" }
  // Secrets (wrangler secret put …): TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET, ADMIN_SECRET_KEY,
  // ADMIN_TELEGRAM_ID, CRYPTO_PAY_TOKEN, SUPABASE_URL, SUPABASE_SERVICE_KEY
}
